# Environment configuration for IronPoint (Beowulf Scheduler)
# Copy to .env.local and adjust values for your environment.

# Toggle between live and test environments
VITE_IS_LIVE=false

# Backend API base URLs
VITE_LIVE_API_URL=https://api.example.com
VITE_TEST_API_URL=http://localhost:8080

# Auth/login endpoints
VITE_LIVE_LOGIN_URL=https://auth.example.com/login
VITE_TEST_LOGIN_URL=http://localhost:8080/login

# Current user endpoint (backend route that returns the authenticated user)
VITE_LIVE_USER_URL=https://api.example.com/api/users/me
VITE_TEST_USER_URL=http://localhost:8080/api/users/me

# Discord role IDs (comma-separated)
VITE_RONIN_ID=
VITE_FLEET_COMMANDER=
VITE_FRIENDLY_ID=
VITE_PROSPECT_ID=
VITE_CREW_ID=
VITE_MARAUDER_ID=
VITE_BLOODED_ID=
VITE_LIVE_BLOODED_PLUS=

# Event announcement channel IDs (Discord)
VITE_PUBLIC_EVENTS_CHANNEL=
VITE_TEST_PUBLIC_EVENTS_CHANNEL=
VITE_PROSPECT_EVENTS_CHANNEL=
VITE_TEST_PROSPECT_EVENTS_CHANNEL=
VITE_CREW_EVENTS_CHANNEL=
VITE_TEST_CREW_EVENTS_CHANNEL=
VITE_MARAUDER_EVENTS_CHANNEL=
VITE_TEST_MARAUDER_EVENTS_CHANNEL=
